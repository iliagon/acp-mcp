{
  "imports": {
    "@agentclientprotocol/sdk": "npm:@agentclientprotocol/sdk@1.7.0",
    "@modelcontextprotocol/server": "npm:@modelcontextprotocol/server@2.3.1",
    "@modelcontextprotocol/server/stdio": "npm:@modelcontextprotocol/server@2.3.1/stdio",
    "zod": "npm:zod@4.6.5"
  },
  "tasks": {
    "build": "deno run --allow-run --allow-write scripts/build.ts",
    "compat": "deno run --allow-env --allow-run scripts/compat.ts",
    "release": "deno run --allow-env --allow-read --allow-write --allow-run scripts/release.ts",
    "install": "deno run --allow-env --allow-read --allow-write --allow-run scripts/release.ts install",
    "provision:antigravity-agy": "deno run --allow-env=LOCALAPPDATA --allow-net=github.com,release-assets.githubusercontent.com,objects.githubusercontent.com --allow-read --allow-write scripts/provision_antigravity_agy.ts",
    "check": "deno check src/main.ts src/cli.ts src/server.ts src/diagnostics/doctor.ts src/config/discovery.ts src/models/policy.ts scripts/build.ts scripts/release.ts scripts/github_release_assets.ts scripts/license_inventory.ts scripts/release_package.ts scripts/release_target.ts scripts/verify_public_release.ts scripts/provision_antigravity_agy.ts scripts/compat.ts scripts/planning_workspace.ts scripts/planning_workflow.ts src/acp/v1_driver.ts src/acp/v2_driver.ts src/acp/driver_factory.ts src/workspaces/stale_cleanup.ts tests/agent_profiles_test.ts tests/custom_agents_test.ts tests/cli_test.ts tests/doctor_test.ts tests/config_discovery_test.ts tests/model_policy_test.ts tests/compat_runner_test.ts tests/config_lifecycle_test.ts tests/delegate_test.ts tests/fixtures/fake_acp_agent.ts tests/fixtures/fake_acp_v2_agent.ts tests/fixtures/custom_acp_agent.ts tests/fixtures/raw_wire_acp_agent.ts tests/mcp_annotations_test.ts tests/event_pagination_test.ts tests/planning_workflow_test.ts tests/server_lifecycle_test.ts tests/session_flow_test.ts tests/session_startup_test.ts tests/windows_process_test.ts tests/v2_protocol_test.ts tests/workspace_tools_test.ts tests/workspaces_test.ts tests/native_mcp_smoke_test.ts tests/release_test.ts tests/github_release_assets_test.ts tests/model_discovery_test.ts",
    "test": "deno test --allow-env --allow-read --allow-run --allow-write --allow-net=opencode.ai"
  }
}
